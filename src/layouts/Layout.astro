---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  pubDate?: string;
  modifiedDate?: string;
  tags?: string[];
  author?: string;
}

const { 
  title, 
  description = 'Crazy Mark - Software Developer Blog', 
  image = '/og-default.png',
  type = 'website',
  pubDate,
  modifiedDate,
  tags = [],
  author = 'Mark Chen'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site).toString();
const supportPageURL = '/support';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- DNS Prefetch & Preconnect -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Crazy Mark" />
    {pubDate && <meta property="article:published_time" content={pubDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:creator" content="@chenjian345" />
    
    <!-- Structured Data: Article -->
    {type === 'article' && pubDate && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "TechArticle",
        "headline": title,
        "description": description,
        "author": {
          "@type": "Person",
          "name": author,
          "url": "https://chenjian345.github.io/about"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Crazy Mark",
          "logo": {
            "@type": "ImageObject",
            "url": "https://chenjian345.github.io/favicon.png"
          }
        },
        "url": canonicalURL.toString(),
        "datePublished": pubDate,
        "dateModified": modifiedDate || pubDate,
        "keywords": tags.join(', '),
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonicalURL.toString()
        }
      })} />
    )}
    
    <!-- Structured Data: Website -->
    {type === 'website' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Crazy Mark",
        "url": "https://chenjian345.github.io",
        "description": "Crazy Mark - Software Developer Blog",
        "author": {
          "@type": "Person",
          "name": author
        }
      })} />
    )}
    
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-113294116-1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'UA-113294116-1');
    </script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8998210359913715"
            crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="site-logo">Crazy Mark</a>
        <nav class="site-nav">
          <a href="/" class:list={{ active: currentPath === '/' }}>文章</a>
          <a href="/#categories">分类</a>
          <a href="/about" class:list={{ active: currentPath === '/about' }}>关于</a>
          <a href={supportPageURL} class:list={{ 'site-nav-support': true, active: currentPath === supportPageURL }}>支持我</a>
        </nav>
      </div>
    </header>

    <div class="site-wrapper">
      <main class="site-main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>© 2016–{new Date().getFullYear()} Mark Chen · <a href="https://github.com/ChenJian345">GitHub</a> · <a href={supportPageURL}>支持我</a></p>
      <p style="margin-top: 0.3rem; font-size: 0.78rem;">Powered by <a href="https://astro.build">Astro</a></p>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
