---
import Layout from './Layout.astro';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  title: string;
  pubDate: string;
  tags?: string[];
  category?: string;
  description?: string;
  excerpt?: string;
}

const { title, pubDate, tags = [], category = '技术', description, excerpt } = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Shanghai',
});

// 分类配色
const categoryColors: Record<string, { bg: string; text: string }> = {
  'iOS': { bg: '#f0fdf4', text: '#15803d' },
  '技术': { bg: '#eff6ff', text: '#2563eb' },
  '设计': { bg: '#fdf4ff', text: '#a21caf' },
  '工具': { bg: '#fff7ed', text: '#c2410c' },
  '技术调研': { bg: '#f0f4ff', text: '#4f46e5' },
};
const catStyle = categoryColors[category] || categoryColors['技术'];

// 为文章生成目录锚点（基于 h2 标题）
const tocId = 'article-toc';
---

<Layout 
  title={`${title} - Crazy Mark`} 
  description={description || excerpt}
  type="article"
  pubDate={pubDate}
  tags={tags}
>
  <a href="/" class="back-link">← 返回首页</a>

  <article itemscope itemtype="https://schema.org/TechArticle">
    <div class="article-header">
      <a href={`/category/${category}/`} class="article-category" style={`background:${catStyle.bg};color:${catStyle.text}`}>{category}</a>
      <h1 itemprop="headline">{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate} itemprop="datePublished">{formattedDate}</time>
        {tags.length > 0 && (
          <div class="post-tags" itemprop="keywords">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
    </div>

    <!-- 文章开头广告 -->
    <AdSlot variant="inline" />

    <div class="article-content" itemprop="articleBody">
      <slot />
    </div>

    <!-- 文章底部广告 -->
    <AdSlot variant="bottom" />

    <!-- 文章底部相关推荐占位 -->
    <div class="article-footer">
      <div class="article-nav">
        <a href="/" class="back-home">← 查看更多文章</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .article-category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-decoration: none;
  }
  .article-category:hover {
    filter: brightness(0.95);
  }
  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
  }
  .article-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .back-home {
    color: #4f46e5;
    text-decoration: none;
    font-weight: 500;
  }
  .back-home:hover {
    text-decoration: underline;
  }
</style>
