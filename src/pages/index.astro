---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// 最新文章单独强调，其余文章按时间继续展示。
const featured = posts.slice(0, 3);
const rest = posts.slice(3);
const categories = Array.from(
  posts.reduce((counts, post) => counts.set(post.data.category, (counts.get(post.data.category) || 0) + 1), new Map<string, number>())
);
---

<Layout title="Crazy Mark - 技术博客">
  <section class="intro-section">
    <p class="intro-eyebrow">MARK CHEN</p>
    <h1>技术实践、AI 学习与长期积累</h1>
    <p>记录软件开发中的问题、解决过程和值得反复回看的知识。</p>
  </section>

  <section class="featured-section">
    <h2 class="section-title">最新文章</h2>
    <div class="featured-grid">
      {featured.map(post => (
        <PostCard
          title={post.data.title}
          slug={post.data.slug}
          pubDate={post.data.pubDate}
          excerpt={post.data.excerpt}
          category={post.data.category}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="more-section">
      <h2 class="section-title">全部文章</h2>
      <div class="more-grid">
        {rest.map(post => (
          <PostCard
            title={post.data.title}
            slug={post.data.slug}
            pubDate={post.data.pubDate}
            excerpt={post.data.excerpt}
            category={post.data.category}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  {categories.length > 1 && (
    <section class="category-section" id="categories">
      <h2 class="section-title">分类浏览</h2>
      <div class="category-list">
        {categories.map(([category, count]) => (
          <a href={`/category/${category}/`} class="category-link">
            <span>{category}</span>
            <span>{count} 篇</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .intro-section {
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .intro-eyebrow {
    margin: 0 0 0.5rem;
    color: #2563eb;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .intro-section h1 {
    max-width: 24ch;
    margin: 0;
    color: #0f172a;
    font-size: 2rem;
    line-height: 1.25;
  }
  .intro-section p:not(.intro-eyebrow) {
    margin: 0.75rem 0 0;
    color: #64748b;
  }
  .section-title {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
    color: #111;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .more-section {
    margin-top: 1rem;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .category-section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
  }
  .category-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.5rem 1rem;
  }
  .category-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.7rem 0;
    color: #334155;
    border-bottom: 1px solid #e2e8f0;
    text-decoration: none;
  }
  .category-link span:last-child {
    color: #94a3b8;
    font-size: 0.82rem;
  }
  .category-link:hover {
    color: #2563eb;
    border-bottom-color: #93c5fd;
  }
  @media (max-width: 640px) {
    .intro-section {
      padding-top: 0;
    }
    .intro-section h1 {
      font-size: 1.65rem;
    }
    .featured-grid, .more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
