---
import Layout from '../layouts/Layout.astro';

const supportURL = 'https://buymeacoffee.com/eyzU2NJ';
---

<Layout title="支持我 - Crazy Mark" description="支持 Crazy Mark 继续写作和分享技术内容">
  <div class="support-page">
    <div class="support-card">
      <p class="support-kicker">支持我</p>
      <h1>请我喝杯咖啡</h1>
      <p class="support-copy">
        如果你喜欢这里的文章、笔记或工具分享，欢迎通过 Buy Me a Coffee 支持我。
        这会直接帮助我继续更新内容。
      </p>

      <a href={supportURL} target="_blank" rel="noreferrer noopener" class="support-button">
        打开 Buy Me a Coffee
      </a>

      <p class="support-note">
        支持页面会跳转到第三方服务。
      </p>
    </div>
  </div>
</Layout>

<style>
  .support-page {
    min-height: calc(100vh - 220px);
    display: grid;
    place-items: center;
    padding: 1rem 0 2rem;
  }

  .support-card {
    width: 100%;
    max-width: 640px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 2.2rem;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  }

  .support-kicker {
    margin: 0 0 0.75rem;
    color: #2563eb;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .support-card h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    color: #0f172a;
  }

  .support-copy {
    margin: 1rem 0 1.5rem;
    color: #475569;
    line-height: 1.8;
    max-width: 52ch;
  }

  .support-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.1rem;
    border-radius: 6px;
    background: #ea580c;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .support-button:hover {
    background: #c2410c;
    text-decoration: none;
    transform: translateY(-1px);
  }

  .support-note {
    margin: 0.9rem 0 0;
    color: #94a3b8;
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    .support-card {
      padding: 1.4rem;
    }

    .support-card h1 {
      font-size: 1.6rem;
    }
  }
</style>
