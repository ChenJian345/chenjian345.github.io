---
// Google AdSense 广告位组件
// 使用说明：
// 1. 登录 Google AdSense 后台 (https://www.google.com/adsense/)
// 2. 创建新的"展示广告"单元
// 3. 将生成的 ad-client 和 ad-slot 替换下面的占位符
// 4. 等待 AdSense 审核通过（新域名通常需要 1-2 周）

interface Props {
  variant?: 'inline' | 'bottom';
  adSlot?: string;
}

const { variant = 'bottom', adSlot } = Astro.props;

const AD_CLIENT = 'ca-pub-8998210359913715';
const DEFAULT_SLOT = '3036245817';
const INLINE_SLOT = '3036245818'; // 建议去 AdSense 后台创建一个新的广告单元，替换这里

const slot = adSlot || (variant === 'inline' ? INLINE_SLOT : DEFAULT_SLOT);
---

<div class={`ad-container ad-${variant}`}>
  <span class="ad-label">赞助内容</span>
  <ins class="adsbygoogle"
    style="display:block; text-align:center;"
    data-ad-client={AD_CLIENT}
    data-ad-slot={slot}
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
</div>

<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>

<style>
  .ad-container {
    padding: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    min-height: 120px;
  }
  .ad-inline {
    margin: 2rem 0;
  }
  .ad-bottom {
    margin: 2rem 0 1rem;
  }
  .ad-label {
    display: block;
    text-align: center;
    font-size: 0.7rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
